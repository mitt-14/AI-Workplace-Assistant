APP_NAME=AI Workplace Assistant
APP_VERSION=1.0.0
ENVIRONMENT=production
LOG_LEVEL=INFO

FRONTEND_PORT=8080
BACKEND_PORT=8000

JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

DEFAULT_LLM_PROVIDER=ollama
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=embeddinggemma

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=application/pdf,text/plain

DOCUMENT_ANALYSIS_CHUNK_CHARACTERS=18000
DOCUMENT_ANALYSIS_CHUNK_OVERLAP_CHARACTERS=300
DOCUMENT_ANALYSIS_MAX_CHUNKS=10
DOCUMENT_ANALYSIS_CONCURRENCY=2
DOCUMENT_ANALYSIS_USE_LLM_SYNTHESIS=false
DOCUMENT_ANALYSIS_CACHE_ENABLED=true

EMAIL_ANALYSIS_BATCH_CONCURRENCY=2
MEETING_ANALYSIS_MAX_CHARACTERS=30000

AGENT_DEFAULT_MAX_STEPS=5
AGENT_STOP_ON_TOOL_ERROR=false

CHUNK_SIZE=1000
CHUNK_OVERLAP=200
DEFAULT_SEARCH_RESULTS=3
MAXIMUM_SEARCH_RESULTS=10
MINIMUM_RELEVANCE_SCORE=0.44
MAXIMUM_CONVERSATION_MESSAGES=10
HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

PASSWORD_RESET_DELIVERY_MODE=smtp
PASSWORD_RESET_FRONTEND_URL=http://localhost:8080
PASSWORD_RESET_EXPIRE_MINUTES=15
PASSWORD_RESET_COOLDOWN_SECONDS=60

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@example.com
SMTP_USE_TLS=true