APP_NAME=AI Workplace Assistant
APP_VERSION=1.0.0
ENVIRONMENT=development
LOG_LEVEL=INFO

DEFAULT_LLM_PROVIDER=ollama

OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

CHUNK_SIZE=1000
CHUNK_OVERLAP=200

DEFAULT_SEARCH_RESULTS=3
MAXIMUM_SEARCH_RESULTS=10

MINIMUM_RELEVANCE_SCORE=0.42

CONVERSATION_DATABASE_PATH=data/conversations.db
MAXIMUM_CONVERSATION_MESSAGES=10

HYBRID_SEMANTIC_WEIGHT=0.7
HYBRID_KEYWORD_WEIGHT=0.3

WORKFLOW_DATABASE_PATH=data/workflows.db

AGENT_DEFAULT_MAX_STEPS=5
AGENT_STOP_ON_TOOL_ERROR=false